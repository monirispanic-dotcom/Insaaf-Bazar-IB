rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin(){return request.auth != null && request.auth.token.email == 'monirispanic@gmail.com' && request.auth.token.email_verified == true;}
  match /products/{id} { allow read: if true; allow create,update,delete: if admin(); }
  match /orders/{id} {
   allow create: if request.resource.data.keys().hasAll(['customerName','phone','address','items','total','status','createdAt']) && request.resource.data.customerName is string && request.resource.data.customerName.size()>1 && request.resource.data.phone is string && request.resource.data.address is string && request.resource.data.items is list && request.resource.data.items.size()>0 && request.resource.data.total is number && request.resource.data.status=='নতুন' && request.resource.data.createdAt==request.time;
   allow read,update,delete: if admin();
  }
 }
}
